{
  "manifest_version": 3,
  "name": "Halogen Dialup",
  "version": "1.1",
  "description": "Plays old internet sounds",
  "permissions": [
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "modem.mp3"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dialup@halogen.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
